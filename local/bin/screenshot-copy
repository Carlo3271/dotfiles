#!/usr/bin/env python3
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk


def notify(message):
    if subprocess.call(
        ["sh", "-c", "command -v notify-send >/dev/null 2>&1"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ) == 0:
        subprocess.Popen(
            ["notify-send", "Screenshot", message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def main():
    out_dir = os.path.expanduser("~/Pictures/Screenshots")
    os.makedirs(out_dir, exist_ok=True)
    path = os.path.join(out_dir, time.strftime("screenshot-%Y%m%d-%H%M%S.png"))

    result = subprocess.run(["scrot", "-s", "-f", "-z", path])
    if result.returncode != 0 or not os.path.exists(path):
        return result.returncode or 1

    pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
    clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    clipboard.set_image(pixbuf)
    clipboard.store()
    notify(f"Copied to clipboard and saved to {path}")

    # Keep owning the X11 clipboard for a while if no clipboard manager stores it.
    GLib.timeout_add_seconds(600, Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
