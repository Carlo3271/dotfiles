#!/usr/bin/env bash
set -euo pipefail

export WINEPREFIX="/home/carlo/.local/share/wineprefixes/fgunz"
export WINEDEBUG="-all"
export WINEESYNC="1"
export WINEFSYNC="1"
export mesa_glthread="false"
export MESA_NO_ERROR="1"
export vblank_mode="0"
export __GL_SYNC_TO_VBLANK="0"
export MESA_VK_WSI_PRESENT_MODE="immediate"

/home/carlo/.local/bin/low-latency-session >/dev/null 2>&1 || true

cd "/home/carlo/.local/share/wineprefixes/fgunz/drive_c/Program Files (x86)/Freestyle GunZ"
wine reg add 'HKCU\Control Panel\Mouse' /v MouseSpeed /t REG_SZ /d 0 /f >/dev/null 2>&1 || true
wine reg add 'HKCU\Control Panel\Mouse' /v MouseThreshold1 /t REG_SZ /d 0 /f >/dev/null 2>&1 || true
wine reg add 'HKCU\Control Panel\Mouse' /v MouseThreshold2 /t REG_SZ /d 0 /f >/dev/null 2>&1 || true
if [[ ! -f config.xml && -f config.performance.xml ]]; then
  cp -f config.performance.xml config.xml
fi

if [[ -f config.xml ]]; then
  perl -0pi -e 's#<WIDTH>.*?</WIDTH>#<WIDTH>1400</WIDTH>#s; s#<HEIGHT>.*?</HEIGHT>#<HEIGHT>900</HEIGHT>#s' config.xml
fi
exec wine "C:\\Program Files (x86)\\Freestyle GunZ\\Launcher.exe"
